# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# Both are server-only. Neither is prefixed NEXT_PUBLIC_, so neither is bundled
# into the JavaScript sent to the browser — every database call happens inside a
# route handler in src/app/api.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The service_role key, NOT the anon key. It bypasses Row Level Security, which
# is why it must never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=
